# =============================================================================
# Roatan Domino — Server OAuth & Deployment Configuration (.env.example)
# =============================================================================
# Copy this file to `.env` in the repository root and fill in your real keys:
#   cp .env.example .env
# Then start or restart Docker Compose (`docker compose up -d --build`) — zero
# code changes required!
# =============================================================================

# Public HTTPS origin where DominoServer is reachable by phones & browsers
# (e.g., https://domino.roatandomino.com or your Cloudflare Tunnel URL).
# Used to build OAuth redirect_uri callbacks automatically:
#   - Google callback:   ${PUBLIC_BASE_URL}/auth/oauth/google/callback
#   - Facebook callback: ${PUBLIC_BASE_URL}/auth/oauth/facebook/callback
PUBLIC_BASE_URL=https://domino.roatandomino.com

# -----------------------------------------------------------------------------
# Google Sign-In (Google Cloud Console -> APIs & Services -> Credentials)
# -----------------------------------------------------------------------------
# Create a "Web application" OAuth 2.0 Client ID and add:
#   Authorized redirect URI: ${PUBLIC_BASE_URL}/auth/oauth/google/callback
# You may also supply comma-separated IDs (e.g. Web + Android Client IDs) in
# GOOGLE_CLIENT_ID if verifying native Android Credential Manager ID tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Facebook Login (Meta for Developers -> Facebook Login -> Settings)
# -----------------------------------------------------------------------------
# Add Valid OAuth Redirect URI:
#   ${PUBLIC_BASE_URL}/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional override (defaults to public_profile so apps without email review never hit Invalid Scopes: email)
# FACEBOOK_SCOPES=public_profile

# -----------------------------------------------------------------------------
# Optional Server / Production Settings
# -----------------------------------------------------------------------------
# DOMINO_MAX_CLIENTS=200
# DOMINO_DOMAIN=domino.roatandomino.com
# MYSQL_CONNECTION_STRING=
