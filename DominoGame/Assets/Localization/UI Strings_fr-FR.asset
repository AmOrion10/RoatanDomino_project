      m_Items: []
  - m_Id: 3666173823541248
    m_Localized: "Vous \xEAtes dans le menu \"Salons\".\nVous avez le choix entre
      :\n\n- Rejoindre une des parties publiques affich\xE9es dans la liste \xE0
      droite\n- Cr\xE9er une partie avec vos propres param\xE8tres\n- Rejoindre une
      partie a l'aide d'un code"
    m_Metadata:
      m_Items: []
  - m_Id: 3667416860057600
    m_Localized: 'elo moyen : 10400'
    m_Metadata:
      m_Items: []
  - m_Id: 3671074142150656
