  - m_Id: 3665296085737472
    m_Localized: Hauptmenu
    m_Metadata:
      m_Items: []
  - m_Id: 3665659706728448
    m_Localized: beitreten
    m_Metadata:
      m_Items: []
  - m_Id: 3214161207296
    m_Localized: privat
    m_Metadata:
      m_Items: []
  - m_Id: 3666173823541248
    m_Localized: "Sie befinden sich im Men\xFC \"Lobbys\".\nSie haben die Wahl zwischen
      :\n\n- Einer der \xF6ffentlichen Partien beitreten, die in der Liste rechts
      angezeigt werden.\n- Eine Partie mit Ihren eigenen Einstellungen erstellen\n-
      Einem Spiel mithilfe eines Codes beitreten"
    m_Metadata:
      m_Items: []
  - m_Id: 3667416860057600
    m_Localized: 'durchschnittliches elo: 10400'
    m_Metadata:
      m_Items: []
