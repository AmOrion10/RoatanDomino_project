    - target: {fileID: 8090952105482477206, guid: d4f9ddf1690ac644baddb9cf1603cf9e, type: 3}
      propertyPath: m_text
      value: "Vous \xEAtes actuellement dans un salon.\nVous avez acc\xE8s \xE0 de
        nombreuses informations :\n\n- Les diff\xE9rents param\xE8tres de la partie\n-
        Le pseudo du cr\xE9ateur du salon\n- Les pseudos des autres joueurs\n\nDe
        plus, vous pouvez :\n\n- Inviter d'autres personnes \xE0 rejoindre le salon
        d'apr\xE8s votre liste d'amis\n- Vous mettre \"Pr\xEAt\" afin de d\xE9buter
        la partie\n- Quitter le salon\n"
      objectReference: {fileID: 0}
